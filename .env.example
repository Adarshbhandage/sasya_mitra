# GEMINI_API_KEY: Optional server-side environment secret if external AI adapter uses Gemini.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# AI_PROVIDER: Replaceable AI inference provider ("mock" | "external" | "native_ml")
AI_PROVIDER="mock"

# EXTERNAL_AI_ENDPOINT: Optional REST endpoint when AI_PROVIDER="external"
EXTERNAL_AI_ENDPOINT=""
EXTERNAL_AI_API_KEY=""

# NATIVE_ML_ENDPOINT: Optional PyTorch/TensorFlow/YOLO FastAPI endpoint when AI_PROVIDER="native_ml"
NATIVE_ML_ENDPOINT="http://127.0.0.1:8000/api/v1/diagnosis/analyze"

# WEATHER_PROVIDER: "open-meteo" | "simulated"
WEATHER_PROVIDER="open-meteo"

# DATABASE_URL: SQLite file path (default ./data/sasya_mitra.db) or PostgreSQL URL for FastAPI deployment
DATABASE_URL="sqlite:///./data/sasya_mitra.db"

# SESSION_SECRET: HMAC signing key for demo role-based expert tokens
SESSION_SECRET="sasya-mitra-dev-session-secret"
